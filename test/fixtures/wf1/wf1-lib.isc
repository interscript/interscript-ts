system "wf1-lib:tha-Thai:Latn:2026" {

# ISC-WF-1 W1 fixture — a library map: named rulesets only, no stages.
# A map that declares only rulesets never executes on its own (§3.2).

metadata {
  name WF1 fixture library
  authority_id WF1
  source_script Thai
  destination_script Latn
}

ruleset leading_vowels {
  sub "ะ" "a"
  sub "ิ" "i"
}

ruleset consonants {
  sub "ก" "k"
}

}
